{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "racklabs",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site"
  },
  "routes": [
    { "pattern": "racktracker.dev", "custom_domain": true },
    { "pattern": "www.racktracker.dev", "custom_domain": true }
  ]
}
